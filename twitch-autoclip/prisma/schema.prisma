generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  twitchId      String    @unique
  login         String    @unique
  displayName   String
  profileImage  String?
  accessToken   String
  refreshToken  String
  tokenExpiresAt DateTime
  scopes        String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  vods          Vod[]
  jobs          Job[]
  clips         Clip[]
}

model Vod {
  id            String    @id @default(cuid())
  twitchVodId   String    @unique
  userId        String
  title         String
  description   String?
  gameName      String?
  language      String?
  duration      Int       // in seconds
  viewCount     Int       @default(0)
  publishedAt   DateTime
  url           String
  thumbnailUrl  String?
  status        VodStatus @default(PENDING)
  downloadedAt  DateTime?
  localPath     String?
  errorMessage  String?

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  highlights    Highlight[]
  clips         Clip[]
  jobs          Job[]

  @@index([userId])
  @@index([status])
}

model Highlight {
  id          String   @id @default(cuid())
  vodId       String
  startTime   Float    // in seconds
  endTime     Float    // in seconds
  confidence  Float    // 0-1
  type        HighlightType
  metadata    Json?
  label       String?
  reviewed    Boolean  @default(false)
  approved    Boolean?

  vod         Vod      @relation(fields: [vodId], references: [id], onDelete: Cascade)
  clips       Clip[]

  @@index([vodId])
  @@index([confidence])
}

model Clip {
  id          String    @id @default(cuid())
  vodId       String
  userId      String
  highlightId String?
  title       String
  description String?
  startTime   Float
  endTime     Float
  duration    Float
  status      ClipStatus @default(GENERATING)
  localPath   String?
  url         String?
  twitchClipId String?
  errorMessage String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  vod         Vod       @relation(fields: [vodId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  highlight   Highlight? @relation(fields: [highlightId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([vodId])
  @@index([status])
}

model Job {
  id          String   @id @default(cuid())
  userId      String
  vodId       String?
  type        JobType
  status      JobStatus @default(PENDING)
  progress    Int      @default(0)
  payload     Json?
  result      Json?
  errorMessage String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vod         Vod?     @relation(fields: [vodId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([type])
}

enum VodStatus {
  PENDING
  DOWNLOADING
  DOWNLOADED
  PROCESSING
  PROCESSED
  FAILED
}

enum HighlightType {
  CHAT_SPIKE
  AUDIO_PEAK
  STREAM_MARKER
  MANUAL
  COMBINED
}

enum ClipStatus {
  GENERATING
  READY
  PUBLISHING
  PUBLISHED
  FAILED
}

enum JobType {
  VOD_DOWNLOAD
  HIGHLIGHT_DETECTION
  CLIP_GENERATION
  CLIP_PUBLISH
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}